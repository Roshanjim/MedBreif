# MedBrief AI — Environment Configuration
# Copy this file to .env and edit as needed

# ─── Database (MySQL) ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medbrief

# ─── Ollama (Optional) ──────────────────────────────────────────────────────
# Set to "true" to use a local LLM via Ollama for medical data extraction.
# The regex parser is used by default (zero RAM overhead).
# If Ollama is enabled but unreachable, the system falls back to regex.
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:instruct

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
